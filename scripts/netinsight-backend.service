[Unit]
Description=NetInsight Backend API Service
After=network.target
Wants=network-online.target

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/home/pi/net-traffic/backend
Environment="PATH=/home/pi/net-traffic/backend/venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
ExecStart=/home/pi/net-traffic/backend/venv/bin/python3 /home/pi/net-traffic/backend/main.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

# Grant raw-socket access for Scapy packet capture without running as root.
# Ambient capabilities are applied by systemd directly (no setcap/file-capability
# dance needed), so NoNewPrivileges can stay enabled.
AmbientCapabilities=CAP_NET_RAW CAP_NET_ADMIN
CapabilityBoundingSet=CAP_NET_RAW CAP_NET_ADMIN

# Security settings
NoNewPrivileges=true
PrivateTmp=true

# Resource limits (adjust as needed)
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target

