# NetInsight Backend Configuration
# Copy this file to .env and customize for your environment

# Network Configuration
NETWORK_INTERFACE=eth0
HOST=0.0.0.0
PORT=8000

# Packet capture source. "local" (default) sniffs NETWORK_INTERFACE directly
# on this machine. "remote_ssh" instead pulls a live tcpdump stream from a
# remote host over SSH - useful when the interface you need to capture
# (e.g. a router's real WAN NIC) can't be physically port-mirrored to this
# machine. Requires REMOTE_CAPTURE_* below.
CAPTURE_MODE=local
# REMOTE_CAPTURE_HOST=192.168.1.1
# REMOTE_CAPTURE_USER=root
# REMOTE_CAPTURE_INTERFACE=eth8
# REMOTE_CAPTURE_SSH_KEY=/home/pi/.ssh/udmpro_capture
#
# Security: the remote SSH key should be dedicated to this purpose and
# restricted via a forced command in the remote host's authorized_keys, e.g.:
#   command="tcpdump -i eth8 -w - -U -s0",no-port-forwarding,no-X11-forwarding,no-agent-forwarding,no-pty ssh-ed25519 AAAA...
# This way, even if the key leaks, it can only stream that one tcpdump
# command and can't be used for an interactive shell on the remote host.

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Database Configuration
DB_PATH=netinsight.db
DATA_RETENTION_DAYS=30

# Rate Limiting
RATE_LIMIT_PER_MINUTE=120

# Logging Configuration
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR, CRITICAL
USE_JSON_LOGGING=true  # true for JSON structured logs, false for plain text
LOG_FILE=  # Optional: path to log file (leave empty to disable file logging)

# Redis Cache Configuration
REDIS_HOST=localhost
REDIS_PORT=6379

# Feature Flags
ENABLE_DNS_TRACKING=true
ENABLE_REVERSE_DNS=true
REVERSE_DNS_TIMEOUT=2.0
REVERSE_DNS_RETRIES=2
ENABLE_SERVICE_FINGERPRINTING=true
ENABLE_DEEP_PACKET_INSPECTION=true
ENABLE_HTTP_HOST_EXTRACTION=true
ENABLE_ALPN_DETECTION=true

# DNS Configuration
DNS_SERVERS=  # Optional: comma-separated custom DNS servers

# Debug Mode
DEBUG=false
