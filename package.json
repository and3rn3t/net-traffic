{
  "name": "net-insight",
  "engines": {
    "node": ">=24.13.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/and3rn3t/net-traffic.git"
  },
  "license": "MIT",
  "description": "Unifying network information on a Raspberry Pi 5.",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:check": "tsc --noEmit && vite build",
    "build:cloudflare": "npm run build",
    "lint": "eslint . --max-warnings 5",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "format:fix": "prettier --write --end-of-line lf \"src/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "type-check": "tsc --noEmit",
    "preview": "vite preview",
    "validate": "npm run type-check && npm run lint && npm run format:check",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report",
    "test:all": "npm run test:run && npm run test:e2e",
    "validate:env": "node scripts/validate-env.js",
    "clean": "node scripts/clean.js",
    "clean:all": "node scripts/clean.js --all",
    "check-deps": "node scripts/check-deps.js",
    "check-deps:python": "node scripts/check-deps.js --python",
    "analyze-bundle": "node scripts/analyze-bundle.js",
    "pre-commit": "node scripts/pre-commit.js",
    "health-check": "node scripts/health-check.js",
    "backend:setup": "bash scripts/backend-setup.sh",
    "db:backup": "bash scripts/db-backup.sh",
    "ensure-env": "bash scripts/ensure-env.sh",
    "pre-install": "bash scripts/pre-install-setup.sh",
    "deploy:cloudflare": "npm run build:cloudflare && wrangler pages deploy dist --project-name=net-traffic",
    "verify:deployment": "bash scripts/verify-cloudflare-deployment.sh",
    "setup:custom-domain": "bash scripts/setup-custom-domain.sh"
  },
  "dependencies": {
    "@radix-ui/colors": "^3.0.0",
    "@radix-ui/react-alert-dialog": "^1.1.6",
    "@radix-ui/react-checkbox": "^1.1.4",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-progress": "^1.1.2",
    "@radix-ui/react-scroll-area": "^1.2.9",
    "@radix-ui/react-select": "^2.1.6",
    "@radix-ui/react-separator": "^1.1.2",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-switch": "^1.1.3",
    "@radix-ui/react-tabs": "^1.1.3",
    "@radix-ui/react-tooltip": "^1.1.8",
    "@tailwindcss/vite": "^4.1.11",
    "@tanstack/react-query": "^5.83.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^3.6.0",
    "lucide-react": "^0.484.0",
    "motion": "^12.6.2",
    "next-themes": "^0.4.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-error-boundary": "^6.0.0",
    "react-grid-layout": "^2.2.4",
    "react-resizable": "^3.2.0",
    "recharts": "^2.15.1",
    "sonner": "^2.0.1",
    "tailwind-merge": "^3.0.2",
    "tw-animate-css": "^1.2.4"
  },
  "devDependencies": {
    "@and3rn3t/eslint-config": "^0.3.0",
    "@playwright/test": "^1.57.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react-swc": "^4.2.2",
    "@vitest/coverage-v8": "^5.0.5",
    "@vitest/ui": "^5.0.5",
    "eslint": "^10.8.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.1.11",
    "typescript": "~5.9.0",
    "vite": "^6.4.1",
    "vitest": "^5.0.5",
    "wrangler": "^4.156.0"
  },
  "workspaces": {
    "packages": [
      "packages/*"
    ]
  }
}
