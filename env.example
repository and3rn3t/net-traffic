# NetInsight Environment Configuration
# Copy this file to .env and update with your values

# ============================================
# Frontend Configuration (Build-time)
# ============================================

# Enable/disable real API mode
# Set to 'true' to connect to backend API, 'false' to use mock data
VITE_USE_REAL_API=true

# Backend API Base URL
# For local development: http://localhost:8000
# For Raspberry Pi on local network: http://192.168.1.100:8000
# For Cloudflare Tunnel: https://net-backend.andernet.dev
# For production (Cloudflare Pages): Set in Cloudflare Dashboard > Pages > Environment Variables
VITE_API_BASE_URL=http://localhost:8000

# ============================================
# Backend Configuration (Raspberry Pi)
# ============================================

# Network interface for packet capture
NETWORK_INTERFACE=eth0

# Server configuration
HOST=0.0.0.0
PORT=8000

# Database path
DB_PATH=/app/data/netinsight.db

# GeoIP2/DB-IP mmdb path for flow geolocation (see scripts/update-geoip-db.sh)
# Leave unset to fall back to well-known system paths (e.g. /usr/share/GeoIP/GeoLite2-City.mmdb)
GEOIP_DB_PATH=/app/data/GeoLite2-City.mmdb

# CORS allowed origins
# For Cloudflare Pages production:
# ALLOWED_ORIGINS=https://net.andernet.dev,https://net-traffic.pages.dev,https://net-backend.andernet.dev,http://localhost,http://localhost:80,http://localhost:3000,http://localhost:5173
# For local development only:
ALLOWED_ORIGINS=http://localhost,http://localhost:80,http://localhost:3000,http://localhost:5173

# Observability thresholds (defaults shown)
SLOW_QUERY_MS=500
LARGE_RESULT_WARN_ROWS=10000
SLOW_REQUEST_MS=2000
HEARTBEAT_INTERVAL_MINUTES=5
WAL_WARN_BYTES=268435456

# Debug mode
DEBUG=false

# Data retention (days)
DATA_RETENTION_DAYS=30

# Rate limiting (requests per minute)
RATE_LIMIT_PER_MINUTE=120

# JWT signing secret - REQUIRED in production. If unset, a random secret is
# generated per-process, which invalidates all sessions on every restart.
# Generate one with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=

# Password for the auto-created default "admin" account (first boot only).
# If unset, a random one-time password is generated and printed to the logs.
DEFAULT_ADMIN_PASSWORD=

# Webhook URL for outbound threat notifications (Slack/Discord/generic HTTP
# POST endpoint). Leave unset to disable. Delivery is best-effort and never
# blocks threat processing.
WEBHOOK_URL=

# 24h network-wide bandwidth threshold (in MB) that triggers a "bandwidth_quota"
# alert. Checked hourly; alerts at most once per day. Leave unset/0 to disable.
BANDWIDTH_ALERT_THRESHOLD_MB=

# ============================================
# Cloudflare Pages Environment Variables
# ============================================
# These should be set in Cloudflare Dashboard:
# 1. Go to Pages > Your Project > Settings > Environment Variables
# 2. Add:
#    - VITE_API_BASE_URL: Your backend URL (e.g., https://net-backend.andernet.dev)
#    - VITE_USE_REAL_API: true
#
# Note: Environment variables prefixed with VITE_ are available at build time
# and are baked into the JavaScript bundle.
